APP_NAME=Gabaymo
APP_ENV=local
APP_KEY=
# Never true in production (stack traces leak secrets). Local development: APP_ENV=local, APP_DEBUG=true.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://api.gabaymo.com, and run `php artisan key:generate`.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gabaymo_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Local development over plain http: SESSION_ENCRYPT may stay true; set SESSION_SECURE_COOKIE=false.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Cookies only over HTTPS. Local http://localhost development: set to false.
SESSION_SECURE_COOKIE=true
# Production (API on api.gabaymo.com, frontends on *.gabaymo.com):
#   SESSION_DOMAIN=.gabaymo.com
#   SESSION_SECURE_COOKIE=true
#   SANCTUM_STATEFUL_DOMAINS=gabaymo.com,partner.gabaymo.com,admin.gabaymo.com
#   CORS_ALLOWED_ORIGINS=https://gabaymo.com,https://partner.gabaymo.com,https://admin.gabaymo.com
#   FRONTEND_URL=https://gabaymo.com

# Frontend hosts that get cookie sessions (host[:port], comma-separated, no scheme).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=gabaymo_ws_

# Local: log (emails are written to storage/logs). Production: smtp/ses/postmark/resend.
# Emails are queued: run `php artisan queue:work` (QUEUE_CONNECTION=database).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Exact browser origins allowed to call the API (comma-separated, with scheme). APP_URL and
# FRONTEND_URL are always allowed; localhost dev ports are added only when APP_ENV is local/testing.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional full PHP regexes (comma-separated) for origins you own, e.g. preview deployments:
#   CORS_ALLOWED_ORIGIN_PATTERNS="#^https://[a-z0-9-]+\.preview\.gabaymo\.com$#"
# Never use a shared-host wildcard such as *.vercel.app.
CORS_ALLOWED_ORIGIN_PATTERNS=
# Member SPA (verification / reset / receipt links, staff set-up links) and partner portal
# (partner emails and partner set-up links; empty = FRONTEND_URL).
FRONTEND_URL=http://localhost:3000
PARTNER_URL=

VITE_APP_NAME="${APP_NAME}"

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ENV=sandbox

# The one admin and one partner `php artisan db:seed` creates (no member accounts).
# Leave the passwords empty: the accounts are "invited" and the seeder prints each set-up link
# (and queues the invitation email). Set a password to make the account active immediately.
SEED_ADMIN_NAME="GabayMo Admin"
SEED_ADMIN_EMAIL=admin@gabaymo.local
SEED_ADMIN_PASSWORD=
SEED_PARTNER_NAME="GabayMo Partner"
SEED_PARTNER_EMAIL=partner@gabaymo.local
SEED_PARTNER_PASSWORD=

# Hours a partner/staff set-up or password link stays valid.
INVITE_EXPIRES_HOURS=72

# GabayMo AI microservice (gabaymo-ai). Secrets are server-side only.
GABAYMO_AI_URL=http://127.0.0.1:8100
# ws -> ai signing secret (same value as gabaymo-ai GABAYMO_AI_INTERNAL_KEY)
GABAYMO_AI_INTERNAL_KEY=
# ai -> ws signing secret (same value as gabaymo-ai GABAYMO_INTERNAL_KEY)
GABAYMO_INTERNAL_KEY=
# During a secret rotation: put the old value here until gabaymo-ai uses the new one, then clear it.
GABAYMO_INTERNAL_KEY_PREVIOUS=
GABAYMO_AI_TIMEOUT=30
GABAYMO_AI_ANSWER_TIMEOUT=120
GABAYMO_AI_RETRIES=2
# Allowed clock difference (seconds) between the two servers when checking signatures.
GABAYMO_SERVICE_CLOCK_SKEW=60
AI_DOCUMENT_UPLOAD_MAX_MB=30

# --- Member usage (share of the plan each answer uses) -----------------------------
# Held when a question is asked, then settled with the real usage (or released if there is no answer).
USAGE_RESERVE_TOKENS=15000
USAGE_TOKENS_PER_QUESTION=10000
# How much each kind of token counts towards the plan.
USAGE_WEIGHT_INPUT=1.0
USAGE_WEIGHT_CACHED_INPUT=0.5
USAGE_WEIGHT_OUTPUT=4.0
# Holds gabaymo-ai never settled are released after this many minutes (credits:sweep, every 5 minutes).
USAGE_RESERVATION_TTL_MINUTES=15

# --- Abuse protection ---------------------------------------------------------------
# Requests per minute (per email + IP for sign-in/password, per account for the rest).
RATE_LIMIT_LOGIN=5
RATE_LIMIT_ADMIN_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_REDEEM=5
RATE_LIMIT_PARTNER=120
RATE_LIMIT_AI=60
# Invitation lookups per IP / accept attempts per email+IP (per minute).
RATE_LIMIT_INVITATION=30
RATE_LIMIT_INVITATION_ACCEPT=5
# Staff accounts lock after this many wrong passwords / two-factor codes.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

# Hours a partner has to reply after accepting a ticket or after a member message.
TICKET_REPLY_HOURS=24

# Realtime notifications (Laravel Reverb websocket server: php artisan reverb:start)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
